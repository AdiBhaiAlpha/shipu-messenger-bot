{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index.cjs" }],
  "functions": {
    "api/index.cjs": {
      "maxDuration": 60,
      "includeFiles": "dist/**"
    }
  }
}
